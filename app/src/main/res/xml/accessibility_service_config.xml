<?xml version="1.0" encoding="utf-8"?>
<!--
  The service exists mainly because Android lets only accessibility services
  capture the microphone during a call. Window content access is used for one
  thing: tapping the speaker button on the in-call screen when the audio API
  cannot turn the speakerphone on (opt-in setting).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/a11y_description"
    android:notificationTimeout="200"
    android:settingsActivity="com.callnotes.ui.MainActivity" />
