<?xml version="1.0" encoding="utf-8"?>
<!--
  The service exists only because Android lets accessibility services capture the
  microphone during a call. It subscribes to no events and cannot read the screen
  (no canRetrieveWindowContent), so the system grants it the least it can.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/a11y_description"
    android:settingsActivity="com.callnotes.ui.MainActivity" />
