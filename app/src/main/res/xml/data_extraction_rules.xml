<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the phone: no cloud backup and no device-to-device transfer of recordings,
  transcripts, the database or settings. (On Android 12+ allowBackup="false" alone does not
  stop device-to-device transfers.)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
