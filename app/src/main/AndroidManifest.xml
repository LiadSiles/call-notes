<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required: the recording itself (captured inside the accessibility service). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Required: knowing when a call starts and ends. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Optional: number, name (cached by the dialer), direction, answered or not. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Optional: "recording now" and problem notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Install-time (no prompt): optional auto-speaker for devices whose mic misses the far side. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Install-time (no prompt): foreground service that keeps mic access while the screen is locked. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Install-time (no prompt): downloading the model files. Audio and text never leave the device. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Install-time (no prompt): foreground service for transcription after a call. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <!-- Install-time (no prompt): re-plans task due-date reminders after a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Optional, off until the user allows it ("Alarms & reminders"): task reminders on the
         minute. Without it they still come, possibly a few minutes late. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Install-time (no prompt): lets the app show the battery-exemption dialog. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".CallNotesApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CallNotes">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Share target for audio (a WhatsApp voice message, a recorder's file…): no screen of
             its own; copies the file in and queues it for its tasks (ShareActivity). -->
        <activity
            android:name=".ui.ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density|locale|layoutDirection"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
            </intent-filter>
        </activity>

        <!-- Restarts the app after the encryption setting changes (own process, no UI). -->
        <activity
            android:name=".ui.RestartActivity"
            android:exported="false"
            android:process=":restart"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".capture.CallRecorderService"
            android:process=":recorder"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".capture.RecordingService"
            android:process=":recorder"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".processing.TranscriptionService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />

        <receiver
            android:name=".util.TaskReminders$Receiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- "Done" / "Snooze" on a task reminder; only our own notifications can reach it. -->
        <receiver
            android:name=".util.TaskReminders$ActionReceiver"
            android:exported="false" />

        <!-- A call finished in the recording process: add it to the database (main process). -->
        <receiver
            android:name=".capture.PendingCalls$Receiver"
            android:exported="false" />

        <!-- Optional GPU acceleration for LiteRT-LM (CPU is used today). -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
